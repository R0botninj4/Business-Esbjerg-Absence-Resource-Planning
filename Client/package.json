{
  "name": "bun-react-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "build": "bun build ./src/index.html --outdir=dist --sourcemap --target=browser --minify --define:process.env.NODE_ENV='\"production\"' --env='BUN_PUBLIC_*'",
    "start": "NODE_ENV=production bun src/index.ts",
    "generate:api": "swagger-typescript-api generate --path http://localhost:5159/openapi/v1.json --output ./src/api --name Api.ts --type-only-imports --unwrap-response-data"
  },
  "dependencies": {
    "react": "^19",
    "react-dom": "^19",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun-plugin-tailwind": "^0.1.2",
    "swagger-typescript-api": "^13.14.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2"
  }
}